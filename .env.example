# Local PostgresSQL connection settings
POSTGRES_DB=shipyard
POSTGRES_USER=shipyard
POSTGRES_PASSWORD=shipyard_local_password

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace_me_with_a_long_random_value
DATABASE_URL=postgresql+psycopg://shipyard:shipyard_local_password@dp:5432/shipyard

# Broswer-visible API base URL
VITE_API_BASE_URL=http://localhost:5000